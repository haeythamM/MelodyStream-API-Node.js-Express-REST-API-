# Example environment variables for MelodyStream API
# Copy this file to .env and fill in real values. DO NOT commit the real .env file.

# Database configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=<your_db_password>
DB_NAME=music_db

# Application port
PORT=3001

# Security note: keep secrets out of version control. Use a secret manager for production.
